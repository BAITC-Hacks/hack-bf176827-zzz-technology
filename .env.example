# Скопировать в .env (make env). .env в git не коммитится.
# APP_DEBUG=true            # цветные dev-логи и стектрейсы паник
# Опциональный LLM-слой (гипотезы кластеров, карточки узлов, ассистент). Без ключа всё работает на шаблонах.
OPENAI_API_KEY=
# Любой ключ из config/*.yaml можно переопределить: APP_PORT=8081, APP_DATA_DIR=..., LLM_MODEL=...
